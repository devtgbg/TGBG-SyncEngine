# ── Zupersync ────────────────────────────────────────────────────────────────
# Keeps Tuper in step with Zuper through the two systems' APIs. It holds no key
# to Tuper's database: records are read from Zuper's API and written through
# Tuper's, and its own state lives in its own Postgres (DATABASE_URL).

PORT=3020
NODE_ENV=production

# ── Tuper ────────────────────────────────────────────────────────────────────
# Tuper's API (records) — the key must carry the `sync` scope
TUPER_API_URL=https://api.tuper.golfbuggyguy.com
TUPER_API_KEY=

# This service's own database: the webhooks it received from both systems, the
# queue of changes for Zuper, its config and run history, and the log of every
# API call it makes. Migrated at boot (store/). The dashboard reads it too.
DATABASE_URL=

# The secret on Tuper's webhooks, so a delivery from Tuper can be verified (x-tuper-signature)
TUPER_WEBHOOK_SECRET=
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Zuper API ────────────────────────────────────────────────────────────────
# A webhook is only a trigger; the record is always re-fetched from Zuper, which
# stays the system of record. Also used to push app-side changes back.
#
# BASE ONLY — do NOT end this with "/api". Request paths already start with
# "/api/", and the two are concatenated, so a trailing "/api" builds
# ".../api/api/jobs/{uid}". Zuper answers that with a 404 and an HTML body, so it
# fails as a JSON parse error rather than as an obvious misconfiguration.
# (config.ts strips it and warns, but set it correctly.)
# The plain and "eks-" hostnames serve the same API; this is the one the database's
# zuper_sync_config.api_base uses, which is what the sync engine actually reads.
ZUPER_API_URL=https://eks-ap-south-1.zuperpro.com
ZUPER_API_KEY=

# ── Inbound webhook authentication ───────────────────────────────────────────
# Zuper has no "secret" field — each webhook carries ONE custom header you
# define (its form is literally `key` / `value`). Set the same pair here and in
# every Zuper webhook. Deliveries that don't match are stored for forensics and
# NOT processed.
ZUPER_WEBHOOK_HEADER=x-zupersync-key
ZUPER_WEBHOOK_SECRET=

# ── Replay ───────────────────────────────────────────────────────────────────
# Zuper retries a webhook three times and then gives up; everything after that is
# ours. Deliveries that were stored but never finished (a restart mid-processing,
# a transient Zuper 500) are retried on this interval.
#
# Attempts are capped: a delivery that can never succeed - its record was deleted
# in Zuper, or it names an entity Zuper has no by-uid read for - stops retrying
# and stays visible in the dashboard with its error, rather than consuming the
# 200-700 req/min API budget forever.
RECONCILE_ENABLED=true
RECONCILE_REPLAY_SECONDS=120
RECONCILE_REPLAY_BATCH=25
RECONCILE_MAX_ATTEMPTS=5

# ── Window sweep ─────────────────────────────────────────────────────────────
# Replay retries deliveries we RECEIVED; this catches the ones that never arrived,
# which is what an outage longer than Zuper's retries produces (max_retries: 4).
#
# It asks Zuper which jobs changed in the window, compares each against when we
# last wrote it (jms.zuper_sync_map.synced_at), and re-fetches ONLY the drifted
# ones. Measured over 7 days: 1,319 changed, of which 458 drifted and 155 were
# never imported — so most of a window is already current and costs nothing.
#
# SWEEP_REQUESTS_PER_MINUTE is deliberately a fraction of Zuper's limit, measured
# at 150/min on this account (x-rate-limit), because live webhook re-fetches
# compete for the same budget. SWEEP_MAX_RESYNCS spreads a large catch-up over
# several runs rather than saturating the API in one burst.
SWEEP_ENABLED=true
SWEEP_EVERY_MINUTES=30
SWEEP_MINUTES_BACK=180
SWEEP_MAX_RESYNCS=200
SWEEP_REQUESTS_PER_MINUTE=45

# ── Push to Zuper ────────────────────────────────────────────────────────────
# Changes made in Tuper (queued by migrations/0002) → Zuper API calls.
#   off      nothing happens
#   dry-run  plan each change and store the requests on the outbox row; send nothing
#   live     send them, then read the job back to confirm
PUSH_MODE=dry-run
PUSH_EVERY_SECONDS=30
PUSH_BATCH=20
PUSH_MAX_ATTEMPTS=5
# A new job arrives in several writes (row, assignees, teams, line items).
PUSH_CREATE_DELAY_SECONDS=90
# Deleting a job in Zuper cannot be undone there.
PUSH_DELETES=false
PUSH_TIMEZONE=Asia/Dubai
# Which kinds of record `live` applies to. Everything else is planned, never sent,
# whatever PUSH_MODE says. Add a kind only after watching its plans on the
# dashboard's "To Zuper" page:  jobs  |  jobs,customers
PUSH_ENTITIES=jobs
# A field changed in Tuper AND in Zuper before the push: zuper-wins leaves Zuper
# alone and says so on the row; tuper-wins pushes regardless.
PUSH_ON_CONFLICT=zuper-wins
# A change older than this is marked skipped, not sent — so turning `live` on
# never replays a backlog of old edits over what Zuper holds now.
PUSH_MAX_AGE_MINUTES=120

# ── API call log ─────────────────────────────────────────────────────────────
# Every call to Zuper's API and Tuper's is recorded in sync.api_calls, with what
# caused it, for the dashboard's "API calls" page. Headers are never kept;
# credential-looking body fields are masked. Bodies are cut at API_LOG_BODY_MAX
# characters and dropped after API_LOG_BODY_HOURS; rows go after API_LOG_DAYS.
API_LOG=on
API_LOG_DAYS=7
API_LOG_BODY_HOURS=48
API_LOG_BODY_MAX=64000
# One row per record written to Tuper (the dashboard's "To Tuper"), kept longer.
TUPER_WRITES_DAYS=30

# The dashboard reads Zupersync's own store — the same DATABASE_URL the service
# has — and nothing else: no Supabase, no Tuper database. Every session it opens
# is read-only (default_transaction_read_only); the only writes are a new version
# of the settings and a request for the engine to act (sync.settings,
# sync.commands), each in its own explicit READ WRITE transaction.
DATABASE_URL=
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# The header Zuper's webhooks authenticate with, so it is masked when a delivery
# is shown. Optional; this is the default.
ZUPER_WEBHOOK_HEADER=x-zupersync-key

# Sign-in (HTTP Basic) for every page. Required in production: without both,
# the dashboard answers 503 rather than showing customer data to anyone.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

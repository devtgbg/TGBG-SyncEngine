# The dashboard reads the same database Zupersync writes.
SUPABASE_URL=https://supabase.golfbuggyguy.com
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_TENANT_ID=

# Sign-in (HTTP Basic) for every page. Required in production: without both,
# the dashboard answers 503 rather than showing customer data to anyone.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
